<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys Xcode can't generate from INFOPLIST_KEY_ build settings (it
	     only passes through the ones it knows). Merged with the generated
	     Info.plist. Kept outside the synchronized source folder so it isn't
	     also copied into the app as a resource. -->
	<!-- Only HTTPS and Apple's own crypto, which is exempt: skips App Store
	     Connect's export compliance question on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3606656264491246~3082223161</string>
	<!-- Google's own SKAdNetwork id, so ad conversions can be attributed
	     without tracking (see the AdMob iOS quick start). -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
</dict>
</plist>
