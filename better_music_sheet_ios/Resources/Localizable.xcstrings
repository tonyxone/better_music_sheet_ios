          }
        }
      }
    },
    "%lld labels" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld label"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld labels"
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音名 %lld 個"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음이름 %lld개"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 个标注"
          }
        },
        "zh-Hant" : {
