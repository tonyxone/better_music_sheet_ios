    "Drag toward a hand to make the other one quieter. Double-tap to even them out." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片方の手の側へドラッグすると、もう一方の手が小さくなります。ダブルタップで同じ音量に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한쪽 손 방향으로 끌면 다른 손 소리가 작아집니다. 두 번 탭하면 같은 음량으로 돌아갑니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向一只手的方向拖动，另一只手的声音会变小。轻点两下恢复为相同音量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向一隻手的方向拖動，另一隻手的聲音會變小。點兩下恢復為相同音量。"
          }
        }
      }
    },
    "Draw with one finger · scroll and zoom with two" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1本指で描画 · 2本指でスクロール・ズーム"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 손가락으로 그리기 · 두 손가락으로 스크롤과 확대/축소"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单指绘制 · 双指滚动和缩放"
          }
        },
