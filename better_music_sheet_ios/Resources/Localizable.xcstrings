    },
    "The color the note names are printed in. Dark colors are easiest to read on white paper." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音名を印刷する色です。白い紙の上では濃い色がいちばん読みやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
