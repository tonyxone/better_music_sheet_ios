    "Premium continues until %@, then ends. You won't be charged again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレミアムは %@ まで利用でき、その後終了します。今後請求されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프리미엄은 %@까지 이용할 수 있으며 그 후 종료됩니다. 더 이상 청구되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高级版会持续到 %@，然后结束。之后不会再收费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進階版會持續到 %@，然後結束。之後不會再收費。"
          }
        }
      }
    },
    "Premium is active on this account through the website, so it works here too — there's nothing more to buy." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントではウェブサイト経由でプレミアムが有効なので、ここでも使えます。追加で購入する必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정은 웹사이트를 통해 프리미엄이 활성화되어 있어 여기서도 쓸 수 있습니다. 더 구입할 필요가 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此账号已通过网站开通高级版，在这里同样可用——无需再购买。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此帳號已透過網站開通進階版，在這裡同樣可用——無需再購買。"
          }
        }
      }
    },
