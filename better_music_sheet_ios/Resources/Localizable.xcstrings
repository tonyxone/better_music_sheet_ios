    "This permanently deletes your account (%@) and your sheet history. This can't be undone." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント（%@）と楽譜の履歴が完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정(%@)과 악보 기록이 영구적으로 삭제되며 되돌릴 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
