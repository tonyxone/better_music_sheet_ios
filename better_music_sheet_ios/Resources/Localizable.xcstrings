    "Back to the printed name; playback restored." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "印刷された音名に戻し、再生も元に戻しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인쇄된 음이름으로 돌아갔고, 재생도 원래대로 돌아왔습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已恢复为印刷的音名，回放也已还原。"
          }
        },
        "zh-Hant" : {
