            "value" : "音名付きのサンプル楽譜を開きます（無料、アカウント不要）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음이름이 표시된 샘플 악보를 엽니다 - 무료, 계정 필요 없음"
          }
        },
        "zh-Hans" : {
